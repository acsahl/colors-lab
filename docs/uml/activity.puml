@startuml activity
' Activity diagram for the COLORS web application.
skinparam shadowing false

|User|
start
:Open login page;
repeat
  :Enter username and password;
  |System|
  :Check credentials in Users table;
  backward:Show "User/Password combination incorrect";
repeat while (Valid?) is (no) not (yes)
:Save login cookie;
:Show color page;

repeat
  |User|
  switch (Choose action)
  case (Search)
    :Enter search text;
    |System|
    :Find user's colors that match;
    :Show matching colors;
  case (Add)
    |User|
    :Enter color name;
    |System|
    :Save color for this user;
    :Show "Color has been added";
  case (Log Out)
    |User|
    :Click "Log Out";
    |System|
    :Clear cookie;
    :Return to login page;
    stop
  endswitch
  |User|
repeat while (Continue?) is (yes) not (no)
stop
@enduml
