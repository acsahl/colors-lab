@startuml class
' Class diagram for the COLORS web application.
' The code is procedural, so each file is shown as a class with a stereotype.
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
hide circle

class "index.html" as Index <<page>>
class "color.html" as Color <<page>>

class "code.js" as Code <<script>> {
  userId : int
  firstName : string
  lastName : string
  --
  doLogin()
  saveCookie()
  readCookie()
  doLogout()
  addColor()
  searchColor()
}

class "md5.js" as MD5 <<library>> {
  md5(string)
}

class "Login.php" as LoginPHP <<endpoint>> {
  login : string
  password : string
}
class "SearchColors.php" as SearchPHP <<endpoint>> {
  search : string
  userId : int
}
class "AddColor.php" as AddPHP <<endpoint>> {
  color : string
  userId : int
}

class "db-config.php" as Config <<config>> {
  dbHost
  dbUser
  dbPass
  dbName
}

class Users <<table>> {
  ID : int
  firstName : string
  lastName : string
  Login : string
  Password : string
}
class Colors <<table>> {
  UserId : int
  Name : string
}

Index ..> Code : uses
Index ..> MD5 : uses
Color ..> Code : uses

Code ..> LoginPHP : doLogin()
Code ..> SearchPHP : searchColor()
Code ..> AddPHP : addColor()

LoginPHP ..> Config
SearchPHP ..> Config
AddPHP ..> Config

LoginPHP ..> Users : SELECT
SearchPHP ..> Colors : SELECT
AddPHP ..> Colors : INSERT

Users "1" -- "0..*" Colors : owns
@enduml
