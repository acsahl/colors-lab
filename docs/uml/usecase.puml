@startuml usecase
' Use case diagram for the COLORS web application.
left to right direction
skinparam shadowing false

actor User
actor "MySQL Database" as DB <<system>>

rectangle "COLORS Web Application" {
  usecase "Log In" as Login
  usecase "Search Colors" as Search
  usecase "Add Color" as Add
  usecase "Log Out" as Logout
}

User -- Login
User -- Search
User -- Add
User -- Logout

Login -- DB
Search -- DB
Add -- DB

note "Search Colors, Add Color and Log Out\nrequire the user to be logged in.\nThere is no registration, edit or delete." as N1
@enduml
